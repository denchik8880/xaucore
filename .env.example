# ---------------------------------------------------------------------------
# XAUCORE environment
# ---------------------------------------------------------------------------
# LOCAL DEV: you do NOT need any of these. `npm run dev` falls back to a local
# SQLite file at ./data/local.db.
#
# PRODUCTION (Vercel): create a Turso database and set both variables in the
# Vercel project (Settings -> Environment Variables), or in a local .env when
# you want dev to hit the real cloud DB.
#
#   npm i -g turso            # or: brew install tursodatabase/tap/turso
#   turso auth signup
#   turso db create xaucore
#   turso db show xaucore --url            ->  TURSO_DATABASE_URL
#   turso db tokens create xaucore         ->  TURSO_AUTH_TOKEN
# ---------------------------------------------------------------------------

TURSO_DATABASE_URL=libsql://xaucore-yourname.turso.io
TURSO_AUTH_TOKEN=your-database-token

# ---------------------------------------------------------------------------
# OPTIONAL: "site closed" / private-access mode (README section 4).
# Set this to any long random secret to enable the owner switch that closes the
# site to visitors. Unset -> the feature is dormant, the site behaves normally.
# Removing this var (and redeploying) is also the lock-out recovery path.
# ---------------------------------------------------------------------------
# OWNER_KEY=change-me-to-a-long-random-string
